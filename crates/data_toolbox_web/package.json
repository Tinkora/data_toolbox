{
  "name": "@tinkora/data-toolbox-web",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build --target web --release --out-dir web/pkg .",
    "prepare:wasm-smoke": "node scripts/prepare-wasm-smoke.mjs",
    "test:prepare-wasm-smoke": "node --test scripts/prepare-wasm-smoke.test.mjs",
    "test:wasm-smoke": "npm run test:prepare-wasm-smoke && npm run prepare:wasm-smoke && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
